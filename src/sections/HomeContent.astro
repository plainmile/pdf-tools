---
import Base from '../layouts/Base.astro';
import { tools, getTool } from '../lib/tools.mjs';
import { siteCopy, langPath } from '../lib/i18n.mjs';
import { featuredToolSlugs, toolGroups, toolSymbols, toolSearchAliases } from '../lib/toolGroups.mjs';
import { websiteJsonLd } from '../lib/seo.mjs';
const { locale = 'en' } = Astro.props;
const p = siteCopy[locale].home;
const href = (path) => langPath(path, locale);
const bySlug = Object.fromEntries(tools.map((tool) => [tool.slug, tool]));
const zh = locale === 'zh';
const labels = zh ? {
  frequent: '常用工具', search: '搜索工具', placeholder: '搜索：合并、压缩、水印、图片…',
  clear: '清除', noResults: '没有匹配的工具，请换一个关键词。', results: '找到 {count} 个工具。',
  categories: '工具分类', open: '打开工具', count: '个工具', countSingular: '个工具',
} : {
  frequent: 'Popular tools', search: 'Find a PDF tool', placeholder: 'Search merge, compress, watermark, image…',
  clear: 'Clear', noResults: 'No tools match that search. Try a different term.', results: '{count} matching tools.',
  categories: 'Tool categories', open: 'Open tool', count: 'tools', countSingular: 'tool',
};
const title = zh ? '免费 PDF 合并、拆分、转换及页面整理工具 - PlainMile' : 'Free PDF Merge, Split, Convert and Page Organizer - PlainMile';
const desc = zh
  ? '免费的 PDF 合并、拆分、页面排序、压缩、水印、页码、图片及文字转换工具。中英双语，在浏览器本地处理，不上传 PDF。'
  : 'Free PDF merge, split, organize, compress, page numbers and image or text converters. Process your documents in your browser, without uploads or signup.';
---
<Base locale={locale} title={title} description={desc} structuredData={websiteJsonLd(locale)}>
  <section class="hero site-container">
    <div class="hero-copy">
      <div class="eyebrow">{p.eyebrow}</div>
      <h1>{p.title}</h1>
      <p class="hero-lead">{p.lead}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#all-tools">{p.explore} <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href={href('/workspace/')}>{p.start}</a>
      </div>
      <ul class="home-assurances"><li>{p.local}</li><li>{p.noaccount}</li><li>{p.ordered}</li></ul>
    </div>
    <aside class="quick-panel" aria-label={labels.frequent}>
      <div class="quick-panel-heading"><h2>{labels.frequent}</h2><span>PDF</span></div>
      <div class="quick-links">
        {featuredToolSlugs.map((slug) => {
          const tool = getTool(bySlug[slug], locale);
          return <a href={href('/' + slug + '/')} class="quick-link">
            <span class="catalog-icon" aria-hidden="true">{toolSymbols[slug]}</span>
            <span>{tool.title}</span><span class="quick-arrow" aria-hidden="true">→</span>
          </a>;
        })}
      </div>
      <p class="quick-note">{zh ? '选择工具后直接处理文件，原始 PDF 不会上传。' : 'Choose a task and work directly on your device. PDFs are not uploaded.'}</p>
    </aside>
  </section>
  <section class="tools-section site-container" id="all-tools" aria-labelledby="all-tools-title">
    <div class="section-heading">
      <div><h2 id="all-tools-title">{p.toolsTitle}</h2></div>
      <p>{p.toolsLead}</p>
    </div>
    <div class="tool-finder" data-tool-finder hidden>
      <label for="tool-search">{labels.search}</label>
      <div class="tool-search-row">
        <input id="tool-search" type="search" data-tool-search autocomplete="off" placeholder={labels.placeholder} />
        <button type="button" data-tool-clear>{labels.clear}</button>
      </div>
      <p class="tool-empty" data-tool-empty hidden>{labels.noResults}</p>
      <p class="tool-search-status" data-tool-results data-count-template={labels.results}
        data-count-template-singular={zh ? labels.results : '{count} matching tool.'}
        role="status" aria-live="polite" aria-atomic="true" hidden></p>
    </div>
    <noscript><p class="tool-finder-nojs" data-testid="tool-finder-nojs">
      {zh ? '搜索需要启用 JavaScript。下方全部工具与分类链接无需 JavaScript 也可直接打开。' : 'Search needs JavaScript. Every tool and category link below remains available without it.'}
    </p></noscript>
    <nav class="category-jump" data-category-jump aria-label={labels.categories}>
      {toolGroups.map((group) => <a data-category-link href={'#group-' + group.id}>{zh ? group.zh : group.en}</a>)}
    </nav>
    <div class="catalog-groups" data-tool-catalog>
      {toolGroups.map((group) => (
        <section class="tool-group" id={'group-' + group.id} data-tool-group aria-labelledby={'heading-' + group.id}>
          <div class="catalog-group-heading">
            <h3 id={'heading-' + group.id}>{zh ? group.zh : group.en}</h3>
            <span data-tool-group-count data-count-unit={labels.count} data-count-singular={labels.countSingular}>{group.slugs.length} {labels.count}</span>
          </div>
          <div class="tool-cards">
            {group.slugs.map((slug) => {
              const tool = getTool(bySlug[slug], locale);
              return <a class="tool-card" data-tool-card="true"
                data-search-text={[tool.title, tool.short, tool.description, slug, ...(toolSearchAliases[slug] || [])].join(' ').normalize('NFKC').toLocaleLowerCase()}
                data-search-compact={[tool.title, tool.short, tool.description, slug, ...(toolSearchAliases[slug] || [])]
                  .map(term => term.normalize('NFKC').toLocaleLowerCase().replace(/\s+/g, '')).join(' ')}
                href={href('/' + slug + '/')}
                aria-label={tool.title + ' — ' + labels.open}>
                <span class="catalog-icon" aria-hidden="true">{toolSymbols[slug]}</span>
                <h4>{tool.title}</h4>
                <p>{tool.short}</p>
                <span class="tool-arrow" aria-hidden="true">→</span>
              </a>;
            })}
          </div>
        </section>
      ))}
    </div>
  </section>
  <section class="steps-band"><div class="site-container"><h2>{p.howTitle}</h2><ol class="home-steps">{p.howSteps.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{step}</li>)}</ol></div></section>
  <section class="bottom-cta site-container"><div><h2>{p.closing}</h2><p>{p.closingText}</p></div><a class="button button-primary" href={href('/workspace/')}>{p.start} <span aria-hidden="true">→</span></a></section>
  <script is:inline>
    (() => {
      const finder = document.querySelector('[data-tool-finder]');
      const search = document.querySelector('[data-tool-search]');
      const catalog = document.querySelector('[data-tool-catalog]');
      const clear = document.querySelector('[data-tool-clear]');
      const empty = document.querySelector('[data-tool-empty]');
      const results = document.querySelector('[data-tool-results]');
      if (!finder || !search || !catalog || !clear || !empty || !results) return;
      const cards = [...catalog.querySelectorAll('[data-tool-card]')];
      const groups = [...catalog.querySelectorAll('[data-tool-group]')];
      const categoryNav = document.querySelector('[data-category-jump]');
      const categoryLinks = new Map([...(categoryNav?.querySelectorAll('[data-category-link]') || [])]
        .map(link => [link.getAttribute('href')?.slice(1), link]));
      // Search is a task finder, not a keyword guessing contest. Remove only
      // common question wrappers and promotional qualifiers, never the source
      // or destination of a conversion ("PDF to JPG" != "JPG to PDF").
      const normalizeQuery = (value) => {
        const original = value.normalize('NFKC').trim().toLocaleLowerCase()
          .replace(/[?？!！。．]+$/g, '').trim();
        const query = original
          .replace(/(?:->|[→➡➜➔⇒])/g, ' to ')
          .replace(/(?:转换成|转换为|转成|转为)/g, '转')
          .replace(/\s+/g, ' ')
          .replace(/\s*转\s*/g, '转')
          .replace(/^(?:how\s+(?:to|can\s+i|do\s+i)|please)\s+/, '')
          // Everyday questions need no special query syntax: "How do I
          // split a PDF?" should lead to the existing Split PDF tool.
          .replace(/^(?:how\s+(?:do|can)\s+i|could\s+you|can\s+you)\s+/, '')
          // Everyday "Can I..." or "I want to..." searches should resolve
          // to an existing task without inventing unsupported conversions.
          .replace(/^(?:can\s+i|i\s+(?:want|need)\s+to|i(?:'d|\s+would)\s+like\s+to)\s+/, '')
          .replace(/^(?:convert|change|turn)\s+/, '')
          .replace(/^(?:(?:如何|怎么|怎样)(?:把|将)?|(?:请)?(?:把|将)|(?:我想|我需要|帮我)(?:把|将)?)\s*/, '')
          .replace(/\bpdfs\b/g, 'pdf')
          .replace(/\b(?:into)\b/g, 'to')
          .replace(/(?:\s+(?:online|for\s+free|free))+$/, '')
          .replace(/\s+(?:converter|conversion)$/, '')
          .replace(/^(?:a|an|the)\s+/, '')
          .replace(/\s+(?:a|an|the)\s+/g, ' ')
          // 'Free online PDF merger' and '免费在线合并PDF工具' are
          // requests for an existing task, not separate SEO landing pages.
          // Keep bare modifier queries ('free', '免费') as no-match queries.
          .replace(/^(?:(?:free|online|private|browser-based)\s+|(?:免费|在线)\s*)+/u, '')
          .replace(/\s+(?:file|files|document|documents)$/, '')
          .replace(/(?:文件|文档|工具)$/, '')
          .replace(/(?:免费|在线)+$/, '')
          .trim();
        // In "add a watermark to PDF", "to" describes the document receiving
        // the action, NOT an image/text conversion direction. Keep the existing
        // ordered "PDF to JPG" / "JPG to PDF" matching unchanged.
        // These are only aliases for real tools, never new SEO landing routes.
        const taskQuery = query
          .replace(/^(?:add|insert|put|place) (?:(?:text|custom) )?watermark (?:to|on|in) pdf$/, 'pdf watermark')
          .replace(/^(?:add|insert|put) page numbers? (?:to|on|in) pdf$/, 'page numbers')
          .replace(/^(remove|delete|extract|rotate|reorder|split) (?:(?:selected|specific|unwanted|some|individual) )?pages? (?:from|in|of) pdf$/,
            (_match, action) => action + ' pdf pages')
          .replace(/^(?:给|为)pdf(?:添加|加)(?:文字)?水印$/u, 'pdf加水印')
          .replace(/^(?:给|为)pdf(?:添加|加)页码$/u, 'pdf加页码')
          .replace(/^(?:从|在)pdf(?:中|里)?(删除|移除|提取)(?:某些|部分|指定)?(?:的)?页面$/u,
            (_match, action) => action === '提取' ? 'pdf提取页面' : 'pdf删除页面');
        // Searching only "free" or "online" must not silently display all tools.
        return taskQuery || original;
      };
      const update = () => {
        const query = normalizeQuery(search.value);
        // Descriptions of almost every Chinese tool say "免费". A search
        // containing ONLY "免费"/"在线" describes no actual task and must
        // not falsely return all tools. Keep all real task queries unchanged.
        // A qualifier alone is not a PDF task. Do not match generic words
        // in catalog descriptions (for example 'private' in a privacy claim).
        const modifierOnly = /^(?:(?:free|online|private|browser-based)(?:\s+|$)|免费|在线)+$/u.test(query);
        let matches = 0;
        for (const card of cards) {
          const words = query.split(' ').filter(Boolean);
          const haystack = card.dataset.searchText;
          // Directional phrases are order-sensitive: "JPG to PDF" must not
          // accidentally return "PDF to JPG" via unordered word matching.
          const directional = /(?:^|\s)to(?:\s|$)|转/.test(query);
          // Treat compact mixed Chinese/Latin task names (e.g. "旋转PDF",
          // "MergePDF") as one phrase without reversing "PDF to JPG".
          // Compact each *field* separately, never concatenate unrelated
          // keywords into a false cross-field match.
          const compactQuery = query.replace(/\s+/g, '');
          const phraseMatch = haystack.includes(query) ||
            card.dataset.searchCompact.includes(compactQuery);
          const visible = !modifierOnly && (directional ? phraseMatch :
            words.every(word => haystack.includes(word)) || phraseMatch);
          card.hidden = !visible;
          if (visible) matches++;
        }
        let visibleGroups = 0;
        for (const group of groups) {
          const count = [...group.querySelectorAll('[data-tool-card]')].filter(card => !card.hidden).length;
          group.hidden = count === 0;
          if (count) visibleGroups++;
          const label = group.querySelector('[data-tool-group-count]');
          if (label) label.textContent = `${count} ${count === 1 ? label.dataset.countSingular : label.dataset.countUnit}`;
          const link = categoryLinks.get(group.id);
          if (link) link.hidden = count === 0;
        }
        if (categoryNav) categoryNav.hidden = visibleGroups === 0;
        empty.hidden = matches !== 0;
        // Do not announce all tools on initial load; only actual searches.
        // One atomic live region conveys either the match count or no-results.
        results.hidden = !query;
        results.textContent = query
          ? (matches === 1 ? results.dataset.countTemplateSingular : results.dataset.countTemplate)
            .replace('{count}', String(matches)) : '';
        // A whitespace-only search still contains characters the user should be able to clear.
        clear.disabled = search.value.length === 0;
      };
      search.addEventListener('input', update);
      clear.addEventListener('click', () => { search.value = ''; update(); search.focus(); });
      update();
      finder.hidden = false;
    })();
  </script>
</Base>
