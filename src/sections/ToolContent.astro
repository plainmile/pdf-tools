---
import Base from '../layouts/Base.astro';
import PdfWorkspace from '../components/PdfWorkspace.jsx';
import PdfUtility from '../components/PdfUtility.jsx';
import { utilitySlugs } from '../lib/utilityCore.mjs';
import { tools, getTool } from '../lib/tools.mjs';
import { toolHelpFor } from '../lib/toolHelp.mjs';
import { relatedToolSlugs } from '../lib/toolGroups.mjs';
import { toolJsonLd } from '../lib/seo.mjs';
import { demoForTool } from '../lib/demoScenarios.mjs';
import { siteCopy, langPath } from '../lib/i18n.mjs';
const { source, locale = 'en' } = Astro.props;
const tool = getTool(source, locale);
const page = siteCopy[locale].toolsPage;
const help = toolHelpFor(tool.slug, locale);
const demo = demoForTool(tool.slug, locale);
const toolsBySlug = Object.fromEntries(tools.map(item => [item.slug, item]));
const relatedTools = relatedToolSlugs(tool.slug);
const href = (path) => langPath(path, locale);
---
<Base locale={locale} title={tool.title + ' - ' + (locale === 'zh' ? '免费本地 PDF 工具' : 'Free & Private')}
  description={tool.description} structuredData={toolJsonLd(tool, locale)}>
  <section class="tool-hero site-container">
    <nav class="breadcrumbs" aria-label={locale === 'zh' ? '面包屑导航' : 'Breadcrumb'}><a href={href('/')}>{page.home}</a><span aria-hidden="true">/</span><span aria-current="page">{tool.title}</span></nav>
    <div class="eyebrow">{page.private}</div>
    <h1>{tool.headline}</h1>
    <p>{tool.description}</p>
    {tool.slug === 'compress-pdf' && <p class="tool-task-tip" data-testid="compression-split-guidance">
      {locale === 'zh'
        ? '每次压缩最多支持 120 页。121–600 页的 PDF 可先使用'
        : 'Compression accepts up to 120 pages per run. For 121–600-page PDFs, first use '}
      <a href={href('/split-pdf/')}>{locale === 'zh' ? '站内拆分 PDF' : 'our Split PDF tool'}</a>
      {locale === 'zh'
        ? '分段，再分别压缩；也需符合文件大小限制。超过 600 页请先使用其他本地 PDF 软件拆分，因为本站拆分工具也最多支持 600 页。文件不会在工具之间自动传递。'
        : ' to create smaller parts, then compress each one (file-size limits still apply). For PDFs over 600 pages, use another local PDF application to divide the source first: our Split PDF tool also has a 600-page limit. Files are not transferred automatically between tools.'}
    </p>}
  </section>
  {demo && <section class="site-container sample-guide" data-testid="demo-guidance" aria-label={demo.title}>
    <div class="sample-guide-copy">
      <h2>{demo.title}</h2>
      <p data-testid="demo-expected">{demo.expected}</p>
      <p class="sample-guide-privacy">{demo.privacy}</p>
    </div>
    <div class="sample-guide-links">
      {demo.files.map(file => <a href={file.path} download={file.name}>{locale === 'zh' ? file.zh : file.en}</a>)}
    </div>
  </section>}
  <section class="site-container workspace-outer">
    {utilitySlugs.includes(tool.slug)
      ? <PdfUtility client:only="react" locale={locale} mode={tool.slug} />
      : <PdfWorkspace client:only="react" locale={locale} mode={tool.slug} />}
    <noscript>
      <p class="tool-js-required" data-testid="tool-js-required">
        {locale === 'zh'
          ? '此工具需要 JavaScript 才能在浏览器本地处理文件。请启用 JavaScript 后刷新页面；文件不会上传服务器。'
          : 'This tool needs JavaScript to process files locally in your browser. Enable JavaScript and reload this page. Your documents are not uploaded.'}
      </p>
    </noscript>
  </section>
  <section class="site-container tool-explanation">
    <div class="explanation-intro">
      <h2>{page.how}</h2>
      <p>{tool.details}</p>
    </div>
    <ol class="steps-list">{tool.steps.map((step, index) =>
      <li><span class="step-index">{String(index + 1).padStart(2, '0')}</span><span>{step}</span></li>)}
    </ol>
  </section>
  {help.length > 0 && <section class="site-container tool-faq" aria-labelledby="tool-faq-heading">
    <h2 id="tool-faq-heading">{locale === 'zh' ? '常见问题' : 'Questions about this tool'}</h2>
    <div class="tool-faq-items">
      {help.map(([question, answer]) => <details class="faq-item">
        <summary>{question}</summary>
        <p>{answer}</p>
      </details>)}
    </div>
  </section>}
  <section class="site-container below-tools">
    <h2>{page.other}</h2>
    <div>{relatedTools.map((slug) =>
      <a href={href('/' + slug + '/')}>{getTool(toolsBySlug[slug], locale).title} <span aria-hidden="true">→</span></a>)}
    </div>
  </section>
</Base>
