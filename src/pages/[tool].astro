---
import ToolContent from '../sections/ToolContent.astro';
import { tools } from '../lib/tools.mjs';
export function getStaticPaths() {
  return tools.map((tool) => ({ params: { tool: tool.slug }, props: { source: tool } }));
}
const { source } = Astro.props;
---
<ToolContent locale="en" source={source} />
