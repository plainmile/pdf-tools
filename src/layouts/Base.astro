---
import '../styles/site.css';
import { langPath, siteCopy, unlocalize } from '../lib/i18n.mjs';
const {
  locale = 'en',
  title = locale === 'zh' ? '免费 PDF 工具 - PlainMile' : 'Free PDF Tools - PlainMile',
  description = locale === 'zh' ? '本地合并、拆分、排序 PDF。文件不上传服务器。' : 'Merge, split and organize PDF files locally in your browser.',
  index = true,
  structuredData = null,
} = Astro.props;
const copy = siteCopy[locale];
const otherLocale = locale === 'zh' ? 'en' : 'zh';
const path = unlocalize(Astro.url.pathname);
const href = (route) => langPath(route, locale);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const langAlternate = (language) => new URL(langPath(path, language), Astro.site).toString();
const pageTitle = title.includes('PlainMile') ? title : `${title} | PlainMile PDF`;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, nofollow'} />
    {index && <link rel="canonical" href={canonical} />}
    {index && <link rel="alternate" hreflang="en" href={langAlternate('en')} />}
    {index && <link rel="alternate" hreflang="zh-CN" href={langAlternate('zh')} />}
    {index && <link rel="alternate" hreflang="x-default" href={langAlternate('en')} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PlainMile PDF" />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {index && <meta property="og:url" content={canonical} />}
    <title>{pageTitle}</title>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('plainmile-pdf-theme');
          if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
        } catch (_error) { /* Private browsing may deny localStorage. */ }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'zh' ? '跳转到主要内容' : 'Skip to main content'}</a>
    <div class="app-shell">
      <header class="site-header">
        <div class="site-container nav-layout">
          <a class="brand" href={href('/')} aria-label="PlainMile PDF">
            <span class="brand-symbol" aria-hidden="true">▤</span>
            <span>plainmile<span class="brand-muted"> / pdf</span></span>
          </a>
          <nav aria-label={locale === 'zh' ? '主要导航' : 'Main navigation'} class="primary-nav">
            <a href={href('/workspace/')}>{copy.nav.workspace}</a>
            <a href={href('/merge-pdf/')}>{copy.nav.merge}</a>
            <a href={href('/split-pdf/')}>{copy.nav.split}</a>
            <a href={href('/#all-tools')}>{copy.nav.tools}</a>
          </nav>
          <div class="nav-settings">
            {index && <a class="language-link" href={langPath(path, otherLocale)} lang={otherLocale === 'zh' ? 'zh-CN' : 'en'} hreflang={otherLocale === 'zh' ? 'zh-CN' : 'en'} aria-label={copy.nav.language + ': ' + (otherLocale === 'zh' ? '中文' : 'English')}>{otherLocale === 'zh' ? '中文' : 'EN'}</a>}
            <label class="theme-switch" data-theme-switch hidden>
              <span class="visually-hidden">{copy.nav.theme}</span>
              <select data-theme-select aria-label={copy.nav.theme}>
                <option value="system">{copy.nav.system}</option>
                <option value="light">{copy.nav.light}</option>
                <option value="dark">{copy.nav.dark}</option>
              </select>
            </label>
          </div>
        </div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <div class="site-container footer-layout">
          <div><a class="footer-brand" href={href('/')}>plainmile / pdf</a><p>{copy.footer.tagline}</p></div>
          <div class="footer-links">
            <a href={href('/workspace/')}>{copy.nav.workspace}</a>
            <a href={href('/privacy/')}>{copy.nav.privacy}</a>
            <!-- Visible source attribution appears on official and independently hosted instances. -->
            <a data-official-site href="https://pdf.plainmile.com/" target="_blank" rel="noopener nofollow">{copy.footer.officialSite}: pdf.plainmile.com ↗</a>
            <a href="https://github.com/plainmile/pdf-tools" target="_blank" rel="noopener noreferrer">{copy.footer.github} ↗</a>
            <a data-report-issue href="https://github.com/plainmile/pdf-tools/issues/new/choose" target="_blank" rel="noopener noreferrer">{copy.footer.report} ↗</a>
            <a data-image-tools href="https://image.plainmile.com/" target="_blank" rel="noopener noreferrer">{copy.footer.imageTools} ↗</a>
            <a href="https://plainmile.com/" rel="noopener noreferrer">{copy.footer.other}</a>
          </div>
        </div>
        <div class="site-container footer-bottom">{copy.footer.local} · <a href="https://github.com/plainmile/pdf-tools/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT License</a></div>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const selector = document.querySelector('[data-theme-select]');
        const switcher = document.querySelector('[data-theme-switch]');
        if (!selector || !switcher) return;
        const current = document.documentElement.dataset.theme;
        selector.value = current === 'dark' || current === 'light' ? current : 'system';
        switcher.hidden = false;
        selector.addEventListener('change', () => {
          const theme = selector.value;
          document.documentElement.dataset.theme = theme;
          try {
            if (theme === 'system') localStorage.removeItem('plainmile-pdf-theme');
            else localStorage.setItem('plainmile-pdf-theme', theme);
          } catch (_error) { /* Storage may be unavailable. Theme still applies. */ }
        });
      })();
    </script>
  </body>
</html>
