{
  "name": "@plainmile/pdf-tools",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "prepare:pdfjs": "node scripts/prepare-worker.mjs",
    "prebuild": "npm run prepare:pdfjs",
    "predev": "npm run prepare:pdfjs",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": { "esbuild": true }
}
